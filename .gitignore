# ---- Go ----
# Build output (go build -o gofs .)
/gofs
/gofs.exe
*.test
*.out
*.prof

# ---- Frontend dependencies ----
/web/node_modules/

# NOTE: /web/dist MUST be committed.
# embed.go embeds it via //go:embed web/dist, so a missing dist directory
# makes `go build` fail (the server refuses to start without index.html).

# ---- Logs and temporary files ----
*.log
/tmp/
/tmpdata/

# ---- Editors / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
