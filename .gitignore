# ---- Go ----
# Build output (go build -o gofs .)
/gofs
/gofs.exe
*.test
*.out
*.prof

# ---- Frontend dependencies / build output ----
/web/node_modules/

# web/dist is generated by `npm run build` (see the Makefile) and must not be
# committed. The empty .gitkeep next to the build output keeps
# `//go:embed all:web/dist` matching on a fresh clone, so `go build` still
# compiles before the frontend has ever been built.
/web/dist/*
!/web/dist/.gitkeep

# ---- Logs and temporary files ----
*.log
/tmp/
/tmpdata/

# ---- Editors / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
